{
  "rewrites": [
    {
      "source": "/informacion-legal",
      "destination": "/informacion-legal.html"
    },
    {
      "source": "/mi-oportuniia/:path*",
      "destination": "/mi-oportuniia.html"
    },
    {
      "source": "/como-funciona",
      "destination": "/como-funciona.html"
    },
    {
      "source": "/acceso",
      "destination": "/acceso.html"
    },
    {
      "source": "/grupo-oportuniia",
      "destination": "/grupo-oportuniia.html"
    },
    {
      "source": "/nuestra-filosofia",
      "destination": "/nuestra-filosofia.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto.html"
    },
    {
      "source": "/servicers",
      "destination": "/servicers.html"
    },
    {
      "source": "/oportunidades",
      "destination": "/web2.html"
    },
    {
      "source": "/mi-oportuniia",
      "destination": "/mi-oportuniia.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/registro",
      "destination": "/index.html"
    },
    {
      "source": "/solicitar-colaboracion",
      "destination": "/index.html"
    },
    {
      "source": "/premium",
      "destination": "/index.html"
    },
    {
      "source": "/inversor",
      "destination": "/index.html"
    },
    {
      "source": "/tecnologia",
      "destination": "/tecnologia.html"
    },
    {
      "source": "/oportunidad",
      "destination": "/oportunidad.html"
    }
  ],
  "headers": [
    {
      "source": "/private/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
