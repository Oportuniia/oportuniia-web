# OPORTUNIIA WEB backend
MONGO_URL=<mongodb-connection-string>
DB_NAME=<database-name>
CORS_ORIGINS=<allowed-origins>

# PRESENTACIÓN → WEB
# Producer base URL: PRESENTACIÓN backend on Render.
PRESENTATION_WEB_BASE_URL=https://presentacion.oportuniia.com
# Same private secret configured in PRESENTACIÓN as PRESENTATION_WEB_M2M_KEY.
WEB_PRESENTATION_M2M_KEY=<secret>
# Private WEB-side admin/ingest secret for sync/status operations.
WEB_PRESENTATION_INGEST_KEY=<secret>
