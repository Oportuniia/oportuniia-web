# Existing WEB backend; never commit real credentials.
MONGO_URL=
DB_NAME=oportuniia_web_staging
CORS_ORIGINS=

# Reuse APP-style WEB-owned opaque sessions; leave disabled until isolated DB is ready.
WEB_IDENTITY_MODE=disabled
WEB_PUBLIC_ORIGIN=
WEB_REQUIRE_MFA=true
WEB_FACTOR_ENCRYPTION_KEY=
WEB_REGISTRATION_ENABLED=false
# Only approved, published legal versions; no placeholder version in real deployment.
WEB_PRIVACY_VERSION=
WEB_TERMS_VERSION=
WEB_REVIEWER_SUBJECT_IDS=

# Mail hosted at Webempresa, accessed by the team through Gmail.
# Use Webempresa's exact account configuration, not inferred Gmail SMTP settings.
WEB_MAIL_BRIDGE_URL=
WEB_MAIL_BRIDGE_KEY=
# Direct SMTP only on hosting/compute where it is permitted; Render free blocks it.
WEB_HOSTING_SMTP_AVAILABLE=false
WEB_SMTP_HOST=
WEB_SMTP_PORT=587
WEB_SMTP_TLS=starttls
WEB_SMTP_USER=info.web@oportuniia.com
WEB_SMTP_PASSWORD=
WEB_MAIL_FROM=OPORTUNIIA <info.web@oportuniia.com>

# Private personal dossier storage. Must block public access and use scoped IAM/KMS.
WEB_PERSONAL_UPLOADS_ENABLED=false
WEB_PERSONAL_BUCKET=
WEB_PERSONAL_KMS_KEY_ID=
WEB_CLAMAV_PRIVATE_HOST=
WEB_CLAMAV_PORT=3310
WEB_WORKER_M2M_KEY=

# Existing investor OIDC adapter remains compatible but is not combined with browser roles.
WEB_AUTH_ISSUER=
WEB_AUTH_AUDIENCE=
WEB_AUTH_JWKS_URL=
PRESENTATION_WEB_BASE_URL=https://oportuniia-presentacion.onrender.com
WEB_PRESENTATION_M2M_KEY=
WEB_PRESENTATION_INGEST_KEY=
WEB_READINESS_M2M_KEY=
WEB_MESSAGES_M2M_KEY=
WEB_DOCUMENTS_PRIVATE_BUCKET=
WEB_DOCUMENTS_PRIVATE_PREFIX=approved/

# Optional Stripe adapter: closed, test-only by default. No real charge is authorized here.
WEB_PAYMENTS_ENABLED=false
WEB_PAYMENTS_LIVE_ENABLED=false
WEB_CONTRACTING_APPROVED=false
WEB_STRIPE_SECRET_KEY=
WEB_STRIPE_WEBHOOK_SECRET=
WEB_STRIPE_PREMIUM_MONTHLY_PRICE=
WEB_STRIPE_PREMIUM_ANNUAL_PRICE=
WEB_PREMIUM_TERMS_VERSION=
