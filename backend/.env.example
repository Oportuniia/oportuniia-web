# OPORTUNIIA WEB backend
MONGO_URL=<mongodb-connection-string>
DB_NAME=<database-name>
CORS_ORIGINS=<allowed-origins>

# PRESENTACIÓN → WEB
# Producer base URL: PRESENTACIÓN backend on Render.
PRESENTATION_WEB_BASE_URL=https://presentacion.oportuniia.com
# Same private secret configured in PRESENTACIÓN as PRESENTATION_WEB_M2M_KEY.
WEB_PRESENTATION_M2M_KEY=<secret>
# Private WEB-side admin/ingest secret for sync/status operations.
WEB_PRESENTATION_INGEST_KEY=<secret>


# WEB sovereign account login; set only in the service environment (never commit values).
WEB_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
WEB_MASTER_USERNAME=RafaMaster
WEB_MASTER_RECOVERY_EMAIL=rafa.querol77@gmail.com
WEB_MASTER_PASSWORD=
WEB_STANDARD_USERNAME=rafa.querol
WEB_STANDARD_RECOVERY_EMAIL=rafa.querol77@gmail.com
WEB_STANDARD_PASSWORD=
WEB_PUBLIC_URL=https://oportuniia.com
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
