# WEB backend. Never commit actual credentials.
MONGO_URL=<mongodb-connection-string>
DB_NAME=<isolated-database-name>
CORS_ORIGINS=<explicit-allowed-origins>

# PRESENTACIÓN owner. HTTPS base and private M2M credentials.
PRESENTATION_WEB_BASE_URL=https://presentacion.oportuniia.com
WEB_PRESENTATION_M2M_KEY=<private-presentation-key>
WEB_PRESENTATION_INGEST_KEY=<private-ingress-key>

# Verified identity provider (RS256); all three required before any real investor API opens.
WEB_AUTH_ISSUER=<https-issuer>
WEB_AUTH_AUDIENCE=<audience>
WEB_AUTH_JWKS_URL=<https-jwks-url>

# Server-only authorities. Browser role selectors/headers never substitute these keys.
WEB_READINESS_M2M_KEY=<private-readiness-key>
WEB_MESSAGES_M2M_KEY=<private-team-replies-key>

# Private LEGAL artifacts, approved individually with source owner, OP permissions and SHA-256.
WEB_DOCUMENTS_PRIVATE_BUCKET=<private-bucket>
WEB_DOCUMENTS_PRIVATE_PREFIX=approved/
# Use the hosting provider's IAM/secret manager for S3 credentials. Never expose them in frontend.

# Email copies remain in an outbox pending provider integration.
# Payments remain closed pending provider, commercial amount, terms and operational authorization.
